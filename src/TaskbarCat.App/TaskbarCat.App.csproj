<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is pulled in only for NotifyIcon; nothing else uses it. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Startup lives in Program.cs, not App.xaml: the window's transparency and
         hit-test setup are load-bearing code, not markup. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <RootNamespace>TaskbarCat.App</RootNamespace>
    <AssemblyName>TaskbarCat</AssemblyName>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <Product>Taskbar Cat</Product>
    <!-- Shows in the exe's Properties dialog and, more usefully, in Task Manager, where an
         unnamed WinExe is indistinguishable from malware. -->
    <FileDescription>Taskbar Cat</FileDescription>
  </PropertyGroup>

  <!-- Publish shape. Self-contained so the download runs on a machine with no .NET, single-file
       so autostart points at one exe that cannot be half-deleted. Trimming stays OFF: WPF is not
       trim-safe and silently drops types it cannot see through reflection.
       Assets stay loose beside the exe (the single-file bundler does not embed Content), so the
       unit of distribution is the publish FOLDER — see tools/publish.ps1, which zips it. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskbarCat.Core\TaskbarCat.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\**\*.*" Link="assets\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Publish needs saying explicitly. The build copies these on CopyToOutputDirectory
           alone, but the file named by ApplicationIcon is dropped from the publish set (it is
           already compiled into the exe), which silently shipped a drop with no tray icon. -->
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
