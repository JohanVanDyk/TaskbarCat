<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Behaviour, needs and sprite metadata. Deliberately targets plain net8.0 with no
    WPF and no Windows reference: the compiler now enforces the layering rule that a
    UI type can never leak into the simulation.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
